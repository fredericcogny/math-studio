# Math Studio - Environment Configuration Example
# Copy this file to '.env' or '.env.local' and supply your Google AI Studio API Key.

# Google AI Studio API Key (Required for Socratic AI Chat feature)
# Get a key at: https://aistudio.google.com/
VITE_GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Optional: Default Gemini Model to use for Socratic tutoring
# Supported options: gemini-2.5-flash, gemini-3.7-flash
VITE_GEMINI_MODEL=gemini-3.7-flash
